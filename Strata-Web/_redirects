# ============================================================
# stratarevenue.com.mx — Redirects Netlify
# Archivo: _redirects (sin extensión)
# Ubicación en el repo: carpeta raíz (junto a index.html)
# ============================================================

# ------------------------------------------------------------
# 1. www → non-www (máxima prioridad, signo ! fuerza el redirect)
# ------------------------------------------------------------
https://www.stratarevenue.com.mx/*  https://stratarevenue.com.mx/:splat  301!

# ------------------------------------------------------------
# 2. Blog index — forzar trailing slash
# ------------------------------------------------------------
/blog   /blog/  301

